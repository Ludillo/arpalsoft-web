{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arpalsoft-baneco-callback",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "api.arpalsoft.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
